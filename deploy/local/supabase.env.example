# Copie para supabase.env (mesma pasta) e preencha. Nunca commitar supabase.env.
# Supabase: Connect → Connection string → Session pooler (porta 5432, SSL).
# Use o Session pooler: a conexão Direct é IPv6 por padrão (IPv4 só com add-on pago)
# e o Transaction pooler (6543) conflita com os prepared statements do Npgsql.

SUPABASE_DATABASE_URL=Host=aws-0-SUA_REGIAO.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.SEU_REF;Password=SUA_SENHA;SSL Mode=Require;Trust Server Certificate=true

# Opcional — o bootstrap gera valores seguros se omitidos:
# SOFIA_A2A_SERVICE_KEY=
# AUTH_JWT_SIGNING_KEY=
# RAG_JWT_SIGNING_KEY=
# OPENAI_API_KEY=

# URL pública do Api.RAG (segundo deploy Vercel ou local via tunnel):
# RAG_BASE_URL=https://seu-rag.vercel.app
